---
import Layout from "../layouts/Layout.astro";

const CITIES = [
  {
    name: "Katowice",
    href: `${import.meta.env.BASE_URL}katowice`,
  },
];
---

<Layout>
  <div
    class="flex h-dvh w-full flex-col items-center justify-center bg-linear-to-br from-red-700 via-red-600 to-rose-500 text-white"
  >
    <img
      src={`${import.meta.env.BASE_URL}mk-logo.webp`}
      alt="MK Bowling"
      class="mb-6 h-16 w-auto sm:h-20"
    />
    <h1 class="mb-2 text-3xl font-bold tracking-tight sm:text-5xl">
      MK Bowling Karaoke
    </h1>
    <p class="mb-8 text-base text-white/80 sm:text-lg">
      Wybierz swoją lokalizację
    </p>
    {
      CITIES.map(({ name, href }) => (
        <a
          href={href}
          class="rounded-xl bg-white/15 px-8 py-4 text-lg font-semibold backdrop-blur-sm ring-1 ring-white/20 transition hover:bg-white/25 sm:text-xl"
        >
          {name}
        </a>
      ))
    }
  </div>
</Layout>
